# Stellar Pay Pro Environment Variables Configuration

# Stellar Network Settings
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; December 2015

# Soroban RPC Node URL
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Application Metadata
VITE_APP_NAME=StellarPay Pro
VITE_APP_URL=https://stellarpay.pro

# Feature Flags
VITE_ENABLE_SOROBAN_CONTRACTS=true
VITE_ENABLE_BATCH_PAYMENTS=true
